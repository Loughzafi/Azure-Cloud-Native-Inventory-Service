@Inventory.Api_HostAddress = http://localhost:5039
@accessToken = replace-with-entra-access-token

GET {{Inventory.Api_HostAddress}}/health/live
Accept: application/json

###

GET {{Inventory.Api_HostAddress}}/api/inventory
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{Inventory.Api_HostAddress}}/api/inventory
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "sku": "SKU-001",
  "name": "Sample item",
  "quantity": 10
}
